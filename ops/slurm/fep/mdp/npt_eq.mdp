; Endpoint production at fixed lambda (pmx NEQ), Parrinello-Rahman ensemble.
; Continues from the C-rescale warmup (npt_warmup.mdp) — do not start this from a
; bare minimized structure. This is the trajectory snapshots are drawn from.
integrator               = md
dt                       = 0.002
nsteps                   = @NSTEPS@
; trr needed for trjconv snapshot extract + grompp -t velocities at switch time
nstxout                  = 5000
nstvout                  = 5000
nstfout                  = 0
nstenergy                = 5000
nstlog                   = 5000
nstxout-compressed       = 5000
compressed-x-grps        = System
; Continue from the warmup: keep its velocities/box, do not re-generate.
continuation             = yes
constraint-algorithm     = lincs
constraints              = h-bonds
lincs-order              = 4
lincs-iter               = 1
cutoff-scheme            = Verlet
nstlist                  = 20
rcoulomb                 = 1.0
rvdw                     = 1.0
coulombtype              = PME
pme_order                = 4
fourierspacing           = 0.16
tcoupl                   = V-rescale
; Separate solute/solvent baths to avoid the hot-solvent/cold-protein artifact
tc-grps                  = Protein non-Protein
tau_t                    = 0.1 0.1
ref_t                    = @REF_T@ @REF_T@
pcoupl                   = Parrinello-Rahman
pcoupltype               = isotropic
tau_p                    = 2.0
ref_p                    = 1.0
compressibility          = 4.5e-5
refcoord_scaling         = com
pbc                      = xyz
gen_vel                  = no
free-energy              = yes
init-lambda              = @INIT_LAMBDA@
delta-lambda             = 0
; NOTE: couple-* directives are intentionally omitted — this is hybrid-topology
; (pmx typeA/typeB) alchemy, not molecule decoupling, so couple-moltype is unset
; and couple-lambda*/couple-intramol would be silently ignored.
sc-function              = gapsys
sc-gapsys-scale-linpoint-q  = 0.3
sc-gapsys-scale-linpoint-lj = 0.85
sc-coul                  = yes
sc-alpha                 = 0.3
sc-sigma                 = 0.25
sc-power                 = 1
nstdhdl                  = 5000
