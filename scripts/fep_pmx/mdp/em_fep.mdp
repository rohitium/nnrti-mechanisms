; Per-endpoint minimization at fixed lambda (free-energy + soft-core).
; Relaxes B-state sidechain atoms that the global A-state em.mdp leaves
; unminimized — matters for growth mutations (e.g. G190E) at init-lambda = 1,
; where the grown sidechain is a dummy in state A and never sees the first EM.
integrator          = steep
nsteps              = 5000
emtol               = 1000.0
emstep              = 0.01
nstlist             = 10
cutoff-scheme       = Verlet
rvdw                = 1.0
rcoulomb            = 1.0
coulombtype         = PME
pbc                 = xyz
constraints         = h-bonds
constraint-algorithm = lincs
free-energy         = yes
init-lambda         = @INIT_LAMBDA@
delta-lambda        = 0
sc-function         = gapsys
sc-gapsys-scale-linpoint-q  = 0.3
sc-gapsys-scale-linpoint-lj = 0.85
sc-coul             = yes
sc-alpha            = 0.3
sc-sigma            = 0.25
sc-power            = 1
