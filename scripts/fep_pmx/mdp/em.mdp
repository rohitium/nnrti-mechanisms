; Energy minimization — validate solvated hybrid topology (steep + cg)
integrator          = steep
nsteps              = 5000
emtol               = 1000.0
emstep              = 0.01
nstlist             = 10
cutoff-scheme       = Verlet
rvdw                = 1.0
rcoulomb            = 1.0
coulombtype         = PME
pbc                 = xyz
constraints         = h-bonds
constraint-algorithm = lincs
