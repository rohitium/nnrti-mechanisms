; Non-equilibrium lambda switching (pmx Crooks/BAR)
integrator               = md
dt                       = 0.002
nsteps                   = @NSTEPS@
nstxout                  = 0
nstvout                  = 0
nstfout                  = 0
nstenergy                = 0
nstlog                   = 1000
nstxout-compressed       = 0
continuation             = no
constraint-algorithm     = lincs
constraints              = h-bonds
lincs-order              = 4
lincs-iter               = 1
cutoff-scheme            = Verlet
nstlist                  = 20
rcoulomb                 = 1.0
rvdw                     = 1.0
coulombtype              = PME
pme_order                = 4
fourierspacing           = 0.16
tcoupl                   = V-rescale
tc-grps                  = System
tau_t                    = 0.1
ref_t                    = @REF_T@
pcoupl                   = Parrinello-Rahman
pcoupltype               = isotropic
tau_p                    = 2.0
ref_p                    = 1.0
compressibility          = 4.5e-5
refcoord_scaling         = com
pbc                      = xyz
gen_vel                  = no
free-energy              = yes
init-lambda              = @INIT_LAMBDA@
delta-lambda             = @DELTA_LAMBDA@
couple-lambda0           = vdw-q
couple-lambda1           = vdw-q
couple-intramol          = no
sc-function              = gapsys
sc-gapsys-scale-linpoint-q  = 0.3
sc-gapsys-scale-linpoint-lj = 0.85
sc-coul                  = yes
sc-alpha                 = 0.3
sc-sigma                 = 0.25
sc-power                 = 1
nstdhdl                  = 1
