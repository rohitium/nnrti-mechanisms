; NPT warmup at fixed lambda — C-rescale barostat, stable from a minimized start,
; run before the Parrinello-Rahman production in npt_eq.mdp. Not used for sampling
; (no trajectory output); it only relaxes the box + velocities so production does
; not start Parrinello-Rahman far from equilibrium.
integrator               = md
dt                       = 0.002
nsteps                   = @NSTEPS@
nstxout                  = 0
nstvout                  = 0
nstfout                  = 0
nstenergy                = 5000
nstlog                   = 5000
nstxout-compressed       = 0
continuation             = no
constraint-algorithm     = lincs
constraints              = h-bonds
lincs-order              = 4
lincs-iter               = 1
cutoff-scheme            = Verlet
nstlist                  = 20
rcoulomb                 = 1.0
rvdw                     = 1.0
coulombtype              = PME
pme_order                = 4
fourierspacing           = 0.16
tcoupl                   = V-rescale
; Separate solute/solvent baths to avoid the hot-solvent/cold-protein artifact
tc-grps                  = Protein non-Protein
tau_t                    = 0.1 0.1
ref_t                    = @REF_T@ @REF_T@
pcoupl                   = C-rescale
pcoupltype               = isotropic
tau_p                    = 5.0
ref_p                    = 1.0
compressibility          = 4.5e-5
pbc                      = xyz
gen_vel                  = yes
gen_temp                 = @REF_T@
free-energy              = yes
init-lambda              = @INIT_LAMBDA@
delta-lambda             = 0
sc-function              = gapsys
sc-gapsys-scale-linpoint-q  = 0.3
sc-gapsys-scale-linpoint-lj = 0.85
sc-coul                  = yes
sc-alpha                 = 0.3
sc-sigma                 = 0.25
sc-power                 = 1
