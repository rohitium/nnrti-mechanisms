results/analysis/fep_jorgensen/_archive/**/windows/
results/analysis/fep_jorgensen/_archive/**/multistate*.nc
results/analysis/fep_jorgensen/legs/**/hybrid_system.xml
results/analysis/fep_jorgensen/legs/**/hybrid_topology.pdb

# FEP pmx NEQ outputs. Track everything light in git (analysis.json, manifests,
# panel CSVs/PNGs, per-genotype QC/overlap/lambda figures) so GitHub keeps the Mac
# and Sherlock in sync. Only the heavy MD artifacts below (trajectories, checkpoints,
# per-switch dgdl, extracted frames/snapshots) are too large for git -- move those
# with scripts/rsync_fep_pmx.sh instead.
# Whitelist, not blocklist: under legs/ git tracks ONLY the light analysis
# provenance below. Everything else -- GROMACS build intermediates (mdp/itp/top/
# gro), equilibration & switch trajectories, checkpoints, extracted frames, and
# GROMACS #backup# files (e.g. "#equil.trr.1#", which an extension rule misses) --
# is heavy or regenerable and moves via scripts/rsync_fep_pmx.sh, not git.
results/analysis/fep_pmx/legs/**
!results/analysis/fep_pmx/legs/**/
!results/analysis/fep_pmx/legs/**/analysis/**
!results/analysis/fep_pmx/legs/**/neq_manifest.csv
!results/analysis/fep_pmx/legs/**/neq_prepare.json
!results/analysis/fep_pmx/legs/**/residue_map.json
!results/analysis/fep_pmx/legs/**/mutation.script

# Same whitelist for the pmx _archive/ tree. Archiving an earlier run MOVES it
# out of legs/ -- which also moved it out of the rule above, so the heavy data it
# carries (per-switch dgdl.xvg, equil.trr/tpr, extracted frames) became
# git-addable. Found 2026-08-28, when archiving the G190E 5 ns arm left ~65 GB
# untracked-but-not-ignored, one `git add -A` away from entering history
# permanently.
results/analysis/fep_pmx/_archive/**
!results/analysis/fep_pmx/_archive/**/
!results/analysis/fep_pmx/_archive/**/analysis/**
!results/analysis/fep_pmx/_archive/**/neq_manifest.csv
!results/analysis/fep_pmx/_archive/**/neq_prepare.json
!results/analysis/fep_pmx/_archive/**/residue_map.json
!results/analysis/fep_pmx/_archive/**/mutation.script
!results/analysis/fep_pmx/_archive/**/README.md

# Operational status scratch files; keep the committed Sherlock reconciliation audit only.
results/.status/complete_at_target.txt
results/.status/incomplete_not_running.txt
results/.status/reconcile_md_metadata_local*.csv

